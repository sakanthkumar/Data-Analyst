# ==========================================
# Data Analyst Agent - Environment Variables
# ==========================================

# --- LLM Provider Selection ---
# Supported values: groq, ollama
LLM_BACKEND=groq

# --- Groq Configuration (Cloud Provider) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_REASONING=deepseek-r1-distill-llama-70b
GROQ_MODEL_CODE=qwen-qwq-32b

# --- Ollama Configuration (Local Provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=llama3
OLLAMA_CODE_MODEL=deepseek-coder:6.7b
OLLAMA_NUM_GPU=-1

# --- Request Timeout ---
LLM_REQUEST_TIMEOUT=60

# --- Backend Server Configuration ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://localhost

# --- Storage & Data Persistence ---
CHROMA_PERSIST_DIR=chroma_db
REPORTS_DIR=reports

# --- Frontend Configuration ---
REACT_APP_API_URL=http://localhost:8000
